{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Alignet Integration Docs",
  "description": "Plataforma de pagos de Alignet para integrar, procesar y gestionar transacciones en canales e-commerce y POS. Incluye APIs, SDKs y herramientas para adquirentes, facilitadores de pago y comercios.",
  "colors": {
    "primary": "#4249e6",
    "light": "#db46f4",
    "dark": "#10366a"
  },
  "logo": {
    "light": "/images/nla1.svg",
    "dark": "/images/alignet-integration-logowhitesv.svg"
  },
  "favicon": {
    "light": "/images/favicon.svg",
    "dark": "/images/favicon-dark.svg"
  },
  "appearance": {
    "default": "light"
  },
  "background": {
    "decoration": "windows",
    "color": {
      "light": "#ffffff",
      "dark": "#161616"
    }
  },
  "fonts": {
    "family": "Roboto"
  },
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
      "label": "Contact Sales",
      "href": "mailto:sales@alignet.com"
    }
  },
  "navigation": {
    "products": [
      {
        "product": "Procesamiento",
        "icon": "credit-card-alt",
        "tabs": [
          {
            "tab": "Vista general",
            "groups": [
              {
                "group": "Primeros pasos",
                "icon": "shoe-prints",
                "pages": [
                  "index",
                  "prerequisites",
                  {
                    "group": "Guía de Integración",
                    "icon": "book-bookmark",
                    "pages": [
                      {
                        "group": "Autorización",
                        "pages": [
                          "ecommerce",
                          "pos",
                          "response",
                          "consideraciones-generales"
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "group": "Ayuda y contacto",
                "icon": "comment-question",
                "pages": [
                  "faq",
                  "support"
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "api": {
    "playground": {
      "display": "interactive"
    }
  },
  "footer": {
    "socials": {
      "linkedin": "https://www.linkedin.com/company/alignet",
      "website": "https://www.Alignet.com"
    }
  },
  "search": {
    "prompt": "Haz una pregunta"
  },
  "contextual": {
    "options": [
      "copy",
      "download-pdf",
      "chatgpt",
      "assistant",
      "view",
      "claude"
    ],
    "display": "header"
  },
  "styling": {
    "latex": false,
    "codeblocks": "system"
  }
}
